# Copy to an external, owner-readable contract file. Do not commit real values.
TARGET_ENVIRONMENT=production
TARGET_DESIGNATION=tailscale-hardened
TARGET_HOSTNAME=replace-with-target-hostname
EXPECTED_NODE_ID=replace-with-tailscale-node-id
EXPECTED_TAILSCALE_IP=replace-with-tailscale-ipv4
SOURCE_REVISION=replace-with-git-revision
ROLLBACK_TAG=replace-with-known-good-image-tag
ROLLBACK_IMAGE_DIGEST=sha256:replace-with-known-good-image-id
SERVICE_NAME=web
WEB_PORT=8081
HEALTH_PATH=/health
SMOKE_PATH=/workspace
HEALTH_MARKER=ok
SMOKE_MARKER=BTCUSD Chart
WAIT_SECONDS=30
COMPOSE_PROJECT_NAME=btcusd-chart
IMAGE_NAME=btcusd-chart
DEPLOY_LOCK_PATH=/run/btcusd-chart
